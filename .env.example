# Where the site loads its content from at runtime.
# Leave unset to use /content.json from your own deployment.
# Point it at any URL that returns the same JSON shape — a GitHub raw file,
# an S3/R2 object, a serverless function, or a headless CMS endpoint.
# The bundled content.js is always the fallback if this fails.
VITE_CONTENT_URL=

# How long to wait before falling back to bundled content (ms).
VITE_CONTENT_TIMEOUT_MS=4000
